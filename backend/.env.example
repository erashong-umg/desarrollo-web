# Copia este archivo como .env y completa tus propios valores.
# NUNCA subas el archivo .env real al repositorio.

# Cadena de conexión de tu clúster de MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/tecnocore?retryWrites=true&w=majority&appName=Cluster0

# Puerto donde correrá la API localmente
PORT=4000

# Orígenes permitidos por CORS, separados por coma (frontend en dev y producción)
CORS_ORIGIN=http://localhost:5173

# Clave secreta para firmar/verificar los JSON Web Tokens.
# Generar un valor propio y aleatorio (ej. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# NUNCA reutilizar el valor de ejemplo ni subir el valor real al repositorio.
JWT_SECRET=reemplaza_este_valor_por_una_cadena_secreta_larga_y_aleatoria

# Tiempo de vida del token. Política de la Tarea 5: expiración estricta de 5 minutos.
JWT_EXPIRES_IN=5m
