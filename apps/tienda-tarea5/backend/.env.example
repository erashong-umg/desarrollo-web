# Copiar como .env solo para ejecución local sin Docker.
# Dentro de Docker Compose, estas variables se definen en el archivo compose
# de cada escenario de despliegue (01-recreate, 02-blue-green, 03-canary) y
# NUNCA se incluyen valores reales de credenciales en este repositorio.

# En los escenarios de Docker Compose se usa un contenedor MongoDB local sin
# autenticación, solo para fines de demostración (no usar este patrón en producción).
MONGODB_URI=mongodb://localhost:27017/tecnocore

# Puerto donde correrá la API
PORT=4000

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Clave secreta para firmar/verificar los JSON Web Tokens.
# Generar un valor propio y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilizar el valor de ejemplo ni subir el valor real al repositorio.
JWT_SECRET=reemplaza_este_valor_por_una_cadena_secreta_larga_y_aleatoria

# Tiempo de vida del token.
JWT_EXPIRES_IN=5m

# Instrumentación de la Tarea 6: identifican la versión/color de esta instancia.
APP_VERSION=1.0.0
APP_COLOR=blue
